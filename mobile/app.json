{
  "expo": {
    "name": "AI Engineering Academy",
    "slug": "ai-engineering-academy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.bakiacikgoz.aiengineeringacademy",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "scheme": "aiengacademy",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store"
    ],
    "extra": {
      "environment": "production",
      "revenueCatEntitlement": "pro",
      "privacyPolicyUrl": "https://aiengineeringacademy.app/privacy.html",
      "accountDeletionUrl": "https://aiengineeringacademy.app/account-deletion.html"
    }
  }
}
